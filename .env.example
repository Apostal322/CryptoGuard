# Copy to .env and fill in. .env is git-ignored; never commit real RPC credentials.

# "real" queries the configured RPC endpoint. "demo" serves clearly labelled fictional fixtures.
# Real mode never falls back to demo data.
CRYPTOGUARD_MODE=real

# Ethereum JSON-RPC endpoint (HTTPS; plain HTTP only for localhost nodes).
# Many providers embed the API key in the URL path — it is redacted from logs and the API.
CRYPTOGUARD_RPC_URL=

# Chain the endpoint must report via eth_chainId (1 = Ethereum Mainnet, 11155111 = Sepolia).
CRYPTOGUARD_CHAIN_ID=1

CRYPTOGUARD_RPC_TIMEOUT_SECONDS=10
CRYPTOGUARD_RPC_MAX_RETRIES=3
CRYPTOGUARD_RPC_MAX_CONCURRENCY=4
CRYPTOGUARD_MAX_LOG_BLOCK_RANGE=1000

# Approval scans: explicit block windows and request budgets (never a full-history scan).
CRYPTOGUARD_APPROVAL_DEFAULT_LOOKBACK_BLOCKS=10000
CRYPTOGUARD_APPROVAL_MAX_SCAN_BLOCKS=200000
CRYPTOGUARD_APPROVAL_MAX_LOG_REQUESTS=300
CRYPTOGUARD_APPROVAL_MAX_PAIRS=200

CRYPTOGUARD_DATABASE_URL=sqlite:///./data/cryptoguard.db

# JSON list. Wildcards are rejected.
CRYPTOGUARD_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CRYPTOGUARD_RATE_LIMIT_PER_MINUTE=30

CRYPTOGUARD_LOG_LEVEL=INFO
CRYPTOGUARD_LOG_JSON=true
